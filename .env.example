# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Comma-separated list of tickers fetched from Deribit.
DERIBIT__TICKERS=btc_usd,eth_usd
# Base URL of the Deribit REST API.
DERIBIT__BASE_URL=https://www.deribit.com/api/v2
# Per-request HTTP timeout (seconds).
DERIBIT__TIMEOUT=10

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=derbit
POSTGRES__PASSWORD=derbit
POSTGRES__DB=derbit

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
# Cron expression for the periodic price fetcher (default: every minute).
CELERY__FETCH_CRON=* * * * *
CELERY__BROKER_URL=redis://localhost:6379/0
CELERY__RESULT_BACKEND=redis://localhost:6379/1
CELERY__TIMEZONE=UTC
